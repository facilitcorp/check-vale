# Copie para .env (nunca commite o .env).
PORT=3000
# Vazio = Postgres embutido (PGlite) em memória; DATA_DIR persiste em disco.
DATABASE_URL=
DATA_DIR=./data
# Obrigatório em produção (>= 32 caracteres).
JWT_SECRET=
JWT_VALIDADE=12h
UPLOADS_DIR=./uploads
CORS_ORIGENS=http://localhost:5173
# 1 = cria catálogo e usuários de demonstração em banco vazio (padrão fora de produção).
SEMEAR_DEMO=
SENHA_DEMO=
